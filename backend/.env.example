APP_NAME=Affordable API
APP_ENV=development
APP_DEBUG=true
APP_API_V1_PREFIX=/api/v1
APP_CORS_ORIGINS=["http://localhost:5173"]
APP_DATABASE_URL=postgresql+asyncpg://affordable:affordable@localhost:5432/affordable
APP_JWT_SECRET=replace-with-at-least-32-random-characters
APP_JWT_ISSUER=affordable-api
APP_JWT_AUDIENCE=affordable-client
APP_ACCESS_TOKEN_TTL_MINUTES=15
APP_REFRESH_TOKEN_TTL_DAYS=30
APP_AUTO_CREATE_SCHEMA=false
# APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# APP_BOOTSTRAP_ADMIN_PASSWORD=change-me-before-start
